{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": { "name": "CasaTica", "version": "0.1.0", "source": "design/prototype/casatica-prototipo.html" },
  "color": {
    "bg":          { "light": "#F7F5EF", "dark": "#141917", "role": "Fondo de página" },
    "surface":     { "light": "#FFFFFF", "dark": "#1C2320", "role": "Tarjetas, barras" },
    "surface2":    { "light": "#EFEDE6", "dark": "#242D29", "role": "Chips inactivos, celdas" },
    "fg":          { "light": "#1B2420", "dark": "#EDEFEA", "role": "Texto" },
    "muted":       { "light": "#5F6B64", "dark": "#A3ADA6", "role": "Texto secundario" },
    "line":        { "light": "#DDD9CE", "dark": "#2F3934", "role": "Bordes" },
    "jungle":      { "light": "#1E6B4A", "dark": "#4FB07F", "role": "Primario" },
    "jungleInk":   { "light": "#124634", "dark": "#8FD3B0", "role": "Texto sobre jungleSoft" },
    "jungleSoft":  { "light": "#DCEFE4", "dark": "#1E3A2D", "role": "Badge verificado, fondos suaves" },
    "sun":         { "light": "#E8A33D", "dark": "#F0B24F", "role": "Acento: estrellas, temporada alta, focus" },
    "sunSoft":     { "light": "#FBEFD9", "dark": "#3B2E17", "role": "Avisos, temporada alta" },
    "sunInk":      { "light": "#7A4E07", "dark": "#F3D6A1", "role": "Texto sobre sunSoft" },
    "whatsapp":    { "light": "#25D366", "dark": "#25D366", "role": "Solo botón Contactar por WhatsApp; texto #063B1E" },
    "whatsappInk": { "light": "#0B7A3B", "dark": "#7BE3A6" },
    "ok":          { "light": "#2E8B57", "dark": "#2E8B57" },
    "warn":        { "light": "#C97A12", "dark": "#C97A12" },
    "bad":         { "light": "#C2432F", "dark": "#C2432F" },
    "badSoft":     { "light": "#FBE3DF", "dark": "#4A2521" }
  },
  "font": {
    "display": { "family": "Bricolage Grotesque", "fallback": "ui-sans-serif, system-ui, sans-serif", "weights": [700, 800], "use": "Títulos, cifras grandes" },
    "body":    { "family": "Nunito Sans", "fallback": "ui-sans-serif, system-ui, sans-serif", "weights": [400, 600, 700], "use": "Texto, UI" },
    "scale":   { "eyebrow": 11, "xs": 12, "small": 13, "base": 15, "md": 17, "lg": 20, "h2": 22, "h1": 24, "h1Detail": 26, "heroMobile": 32, "heroDesktop": 50 },
    "numeric": "tabular-nums"
  },
  "radius": { "card": 14, "listing": 16, "button": 12, "input": 10, "pill": 999, "photo": 12, "sheet": 22 },
  "space": { "unit": 4, "gap": [8, 10, 12, 14, 16], "viewPaddingMobile": 16, "viewPaddingDesktop": 32 },
  "shadow": { "soft": "0 1px 2px rgba(27,36,32,.06), 0 8px 24px -12px rgba(27,36,32,.18)" },
  "breakpoints": { "twoColumns": 640, "desktopNav": 800, "threeColumnsMapSticky": 1000 },
  "money": { "defaultCurrency": "CRC", "formats": { "CRC": "₡95.000", "USD": "$120" }, "locale": "es-CR" }
}
