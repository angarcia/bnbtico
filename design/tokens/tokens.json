{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "bnbtico",
    "version": "0.2.1",
    "source": "Lienzo de diseño «bnbtico · propuestas de diseño», dirección B «Sol y sal» (2026-10-20)",
    "changelog": "0.2.1: margen 16 px, iconos de pestaña 26, terracota de texto #B44C30, colores del calendario y de «¿Cuándo?», ocre solo para dinero. 0.2.0: paleta Sol y sal (crema, verde selva, salvia, terracota, ocre); logo de la rana en terracota; Outfit + Figtree; barra inferior plana. Sustituye el coral/#FF385C y Bricolage/Nunito de 0.1.0. Cabecera, tarjeta de oferta, días del calendario y contador de la barra añadidos tras cerrar la v1 en el lienzo."
  },
  "color": {
    "bg": {
      "light": "#FFFBF2",
      "dark": "#141917",
      "role": "Fondo de página (crema) y barra inferior"
    },
    "surface": {
      "light": "#FFFFFF",
      "dark": "#1C2320",
      "role": "Tarjetas, buscador"
    },
    "surface2": {
      "light": "#F6E7C8",
      "dark": "#2B2A22",
      "role": "Chips inactivos (arena)"
    },
    "fg": {
      "light": "#1C2B2A",
      "dark": "#EDEFEA",
      "role": "Texto (tinta)"
    },
    "muted": {
      "light": "#5C6B69",
      "dark": "#A3ADA6",
      "role": "Texto secundario, pestañas inactivas"
    },
    "line": {
      "light": "#E6DCC6",
      "dark": "#2F3934",
      "role": "Bordes, sombra plana de tarjetas"
    },
    "lineNav": {
      "light": "#EADFC8",
      "dark": "#2F3934",
      "role": "Línea superior de la barra inferior"
    },
    "brand": {
      "light": "#D65C3C",
      "dark": "#E8785A",
      "role": "Marca: logo de la rana, corazón de favoritos"
    },
    "brandInk": {
      "light": "#B44C30",
      "dark": "#F0A48C",
      "role": "Texto pequeño terracota, contadores, «Nueva», marcadores del mapa y pestaña activa (blanco encima 5,1:1)"
    },
    "primary": {
      "light": "#2F5D45",
      "dark": "#7FA98A",
      "role": "Botones de acción (relleno) y contorno de botones secundarios: Nueva, Compartir ficha, Ingresar"
    },
    "primaryOn": {
      "light": "#FFFBF2",
      "dark": "#16331F",
      "role": "Texto sobre primary"
    },
    "selection": {
      "light": "#7FA98A",
      "dark": "#3E6B52",
      "role": "Chip seleccionado (Vacacional/Mensual, características)"
    },
    "selectionInk": {
      "light": "#16331F",
      "dark": "#DCE8DF",
      "role": "Texto sobre selection"
    },
    "stateSoft": {
      "light": "#DCE8DF",
      "dark": "#1F3A2C",
      "role": "Fondos suaves de estado: Activa, WhatsApp verificado; relleno de respaldo tras las fotos"
    },
    "stateInk": {
      "light": "#2F5D45",
      "dark": "#B9D2BF",
      "role": "Texto sobre stateSoft"
    },
    "sun": {
      "light": "#F2B544",
      "dark": "#F0B24F",
      "role": "Dinero y avisos de pago: pagar, \"Activar suscripción\", \"Añadir método de pago\", y la fila o tarjeta de suscripción o método de pago cuando falta algo. Nunca acciones normales"
    },
    "sunSoft": {
      "light": "#FBE8C2",
      "dark": "#3B2E17",
      "role": "Casilla «por pagar», etiqueta «Pendiente de pago»"
    },
    "sunInk": {
      "light": "#7A4E07",
      "dark": "#F3D6A1",
      "role": "Texto sobre sunSoft"
    },
    "reviewSoft": {
      "light": "#F0E6D2",
      "dark": "#2B2A22",
      "role": "Casilla y etiqueta «En revisión»"
    },
    "overlay": {
      "light": "rgba(28,43,42,0.86)",
      "dark": "rgba(11,11,12,0.86)",
      "role": "Píldoras sobre fotos: precio, contador 1/14, etiqueta Mensual. Texto primaryOn"
    },
    "overlayButton": {
      "light": "#FFFBF2",
      "dark": "#1C2320",
      "role": "Botones redondos sobre la foto de la ficha: volver, compartir, favorito"
    },
    "whatsapp": {
      "light": "#25D366",
      "dark": "#25D366",
      "role": "Solo botón Contactar por WhatsApp; texto #063B1E"
    },
    "whatsappInk": {
      "light": "#063B1E",
      "dark": "#063B1E"
    },
    "ok": {
      "light": "#2F5D45",
      "dark": "#7FA98A"
    },
    "warn": {
      "light": "#C97A12",
      "dark": "#F0B24F"
    },
    "bad": {
      "light": "#C2432F",
      "dark": "#E8785A"
    },
    "badSoft": {
      "light": "#FBE3DF",
      "dark": "#4A2521"
    }
  },
  "font": {
    "display": {
      "family": "Outfit",
      "fallback": "ui-sans-serif, system-ui, sans-serif",
      "weights": [
        700,
        800
      ],
      "use": "Títulos, nombres de casa, cifras grandes, botón de WhatsApp"
    },
    "body": {
      "family": "Figtree",
      "fallback": "ui-sans-serif, system-ui, sans-serif",
      "weights": [
        400,
        500,
        600,
        700
      ],
      "use": "Texto, UI, chips, etiquetas"
    },
    "scale": {
      "eyebrow": 11,
      "xs": 12,
      "small": 13,
      "base": 15,
      "md": 16,
      "lg": 19,
      "h2": 22,
      "h1": 30,
      "heroMobile": 34,
      "heroDesktop": 50
    },
    "letterSpacingDisplay": "-0.02em",
    "numeric": "tabular-nums"
  },
  "radius": {
    "card": 24,
    "listing": 24,
    "photo": 24,
    "thumb": 18,
    "button": 999,
    "cta": 18,
    "input": 999,
    "chip": 999,
    "pill": 999,
    "sheet": 28,
    "tile": 20
  },
  "space": {
    "unit": 4,
    "gap": [
      8,
      10,
      12,
      14,
      16
    ],
    "viewPaddingMobile": 20,
    "viewPaddingDesktop": 32,
    "safeTop": 56
  },
  "shadow": {
    "card": "0 2px 0 #E6DCC6",
    "float": "0 2px 0 #E6DCC6, 0 10px 24px -14px rgba(28,43,42,.35)"
  },
  "components": {
    "bottomNav": {
      "height": 84,
      "background": "{color.bg}",
      "borderTop": "2px solid {color.lineNav}",
      "active": "{color.brandInk}",
      "inactive": "{color.muted}",
      "icon": 26,
      "label": 12,
      "note": "Plana, pegada al borde, icono + etiqueta en cada pestaña; sin píldora. Pestaña activa: icono en línea 2.4 y etiqueta en negrita.",
      "badge": {
        "bg": "{color.brandInk}",
        "fg": "{color.primaryOn}"
      }
    },
    "button": {
      "primary": {
        "bg": "{color.primary}",
        "fg": "{color.primaryOn}",
        "height": 44,
        "radius": "{radius.button}"
      },
      "secondary": {
        "border": "1.5px solid {color.primary}",
        "fg": "{color.primary}",
        "height": 44,
        "radius": "{radius.button}"
      },
      "whatsapp": {
        "bg": "{color.whatsapp}",
        "fg": "{color.whatsappInk}",
        "height": 56,
        "radius": "{radius.cta}",
        "note": "Ancho completo, precio en una línea encima; nunca comparte fila con otro elemento."
      }
    },
    "chip": {
      "inactive": {
        "bg": "{color.surface2}",
        "fg": "{color.fg}"
      },
      "active": {
        "bg": "{color.selection}",
        "fg": "{color.selectionInk}"
      },
      "height": 40
    },
    "photoPill": {
      "bg": "{color.overlay}",
      "fg": "{color.primaryOn}",
      "radius": "{radius.pill}"
    },
    "header": {
      "root": "logo 38 px alto a la izquierda, acción opcional a la derecha, H1 34 px debajo; solo en pantallas de la barra inferior",
      "flow": "flecha de volver 44 px + título 24 px; sin logo",
      "safeTop": 56
    },
    "offerCard": {
      "bg": "{color.surface}",
      "title": "{color.sunInk}",
      "counter": "{color.sunInk}",
      "bar": "{color.sun}",
      "barTrack": "{color.sunSoft}",
      "body": "{color.fg}",
      "link": "{color.primary}",
      "note": "Tarjeta de la oferta de lanzamiento: blanca, título y cifras en tinta ocre, barra ocre, botón/enlace verde."
    },
    "calendarDay": {
      "available": {
        "bg": "{color.stateSoft}",
        "fg": "{color.fg}",
        "price": "{color.primary}"
      },
      "free": "#DCE8DF",
      "busy": {
        "bg": "#F7E3D3",
        "fg": "#9A4B2A"
      },
      "selected": {
        "border": "2px solid {color.brandInk}"
      },
      "special": "★ junto al número cuando el precio difiere del base",
      "search": {
        "selected": "#D9775A",
        "selectedText": "#1C2B2A",
        "band": "#F7E6D8"
      }
    }
  },
  "spacing": {
    "gutter": 16,
    "note": "Margen lateral de las pantallas y de las barras fijas (--gutter)"
  },
  "breakpoints": {
    "twoColumns": 640,
    "desktopNav": 800,
    "threeColumnsMapSticky": 1000
  },
  "money": {
    "defaultCurrency": "CRC",
    "formats": {
      "CRC": "₡95 000",
      "USD": "$185"
    },
    "locale": "es-CR",
    "note": "Siempre orientativo; dólares solo al mostrar"
  }
}
