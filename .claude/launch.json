{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "web",
        "dev",
        "--port",
        "3000"
      ],
      "port": 3000,
      "url": "http://127.0.0.1:3000"
    },
    {
      "name": "app",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "app",
        "dev",
        "--port",
        "5173",
        "--strictPort",
        "--host",
        "127.0.0.1"
      ],
      "port": 5173,
      "url": "http://127.0.0.1:5173"
    }
  ]
}
