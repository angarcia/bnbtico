# Copiar a .env.local. Nunca subir .env.local al repo.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Contraseña de pruebas.bnbtico.com (vacía = sin contraseña, p. ej. en local)
PREVIEW_PASSWORD=
# Clave para firmar cookies de sesión (cualquier texto largo y aleatorio)
SESSION_SECRET=
# `pruebas` muestra la app; vacío muestra solo «Muy pronto»
NEXT_PUBLIC_STAGE=
# WhatsApp de atención de bnbtico (E.164), uno por rol
NEXT_PUBLIC_WA_OWNERS=
NEXT_PUBLIC_WA_GUESTS=
# `demo` fuerza el modo sin envíos aunque haya Supabase configurado
AUTH_PROVIDER=
