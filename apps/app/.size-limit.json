[
  {
    "name": "Zona privada · JS inicial (todo salvo los trozos diferidos: Leaflet, supabase-js, el asistente de publicar, la subida de fotos, la zona del admin, Favoritos y Web Vitals tras load)",
    "path": [
      "dist/client/assets/*.js",
      "!dist/client/assets/approx-map-leaflet-*.js",
      "!dist/client/assets/location-leaflet-*.js",
      "!dist/client/assets/leaflet-*.js",
      "!dist/client/assets/supabase-data-*.js",
      "!dist/client/assets/publicar-*.js",
      "!dist/client/assets/resize-*.js",
      "!dist/client/assets/concurrency-*.js",
      "!dist/client/assets/admin-*.js",
      "!dist/client/assets/review-*.js",
      "!dist/client/assets/vitals-*.js",
      "!dist/client/assets/favoritos-*.js"
    ],
    "limit": "150 KB",
    "gzip": true
  },
  {
    "name": "Asistente de publicar · trozo diferido (sin Leaflet), con la subida de fotos",
    "path": [
      "dist/client/assets/publicar-*.js",
      "dist/client/assets/location-leaflet-*.js",
      "dist/client/assets/resize-*.js",
      "dist/client/assets/concurrency-*.js"
    ],
    "limit": "15 KB",
    "gzip": true
  },
  {
    "name": "Zona del admin · trozo diferido (cola, revisar y segundo código)",
    "path": [
      "dist/client/assets/admin-*.js",
      "dist/client/assets/review-*.js"
    ],
    "limit": "12 KB",
    "gzip": true
  },
  {
    "name": "Favoritos · trozo diferido (la pantalla; el corazón y la lista del teléfono van en el JS inicial)",
    "path": [
      "dist/client/assets/favoritos-*.js"
    ],
    "limit": "4 KB",
    "gzip": true
  },
  {
    "name": "Web Vitals · trozo que se importa tras load (web-vitals y su baliza)",
    "path": [
      "dist/client/assets/vitals-*.js"
    ],
    "limit": "5 KB",
    "gzip": true
  },
  {
    "name": "Service worker · /sw.js (se descarga aparte, fuera de la zona privada)",
    "path": [
      "dist/client/sw.js"
    ],
    "limit": "4 KB",
    "gzip": true
  }
]
