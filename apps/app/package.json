{
  "name": "app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/base-local.mjs && node scripts/dev-vars.mjs && vite",
    "build": "vitest run --project unit tests/unit/architecture.test.ts && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:e2e": "node scripts/base-local.mjs && playwright test",
    "lighthouse": "playwright test -c playwright.lighthouse.config.ts",
    "size": "size-limit",
    "deploy": "wrangler deploy",
    "test:db": "node scripts/base-local.mjs && vitest run --project db",
    "db:types": "cd ../.. && supabase gen types typescript --local --schema public > apps/app/src/domain/database.types.ts",
    "dev:vars": "node scripts/dev-vars.mjs",
    "datos:prueba": "node scripts/base-local.mjs && node scripts/casas-de-prueba.mjs",
    "db:al-dia": "node scripts/base-local.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/query-async-storage-persister": "5.104.5",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-query-persist-client": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "hono": "4.13.13",
    "leaflet": "1.9.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "web-vitals": "6.2.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@playwright/test": "1.64.1",
    "@size-limit/file": "14.3.0",
    "@types/leaflet": "1.9.21",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "lighthouse": "13.5.0",
    "size-limit": "14.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.152.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  }
}
