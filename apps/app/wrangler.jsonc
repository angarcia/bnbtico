{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bnbtico",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Sin esto, las navegaciones a /casa/* recibirían el index.html de la SPA sin pasar por el worker.
    "run_worker_first": ["/casa/*", "/robots.txt"]
  },
  "observability": { "enabled": true },
  "vars": { "ENVIRONMENT": "local" },
  "env": {
    "pruebas": {
      "vars": { "ENVIRONMENT": "pruebas" },
      "routes": [{ "pattern": "nueva.bnbtico.com", "custom_domain": true }],
      "workers_dev": true,
      "preview_urls": true
    },
    "production": {
      "vars": { "ENVIRONMENT": "production" },
      "workers_dev": false,
      "preview_urls": false
    }
  }
}
